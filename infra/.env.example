# Copy to infra/.env (not committed) and change for any non-local use.
# docker compose reads infra/.env automatically for ${VAR} substitution.

# MySQL (defaults shown are local-dev only)
MYSQL_DATABASE=spylove
MYSQL_USER=spylove
MYSQL_PASSWORD=spylove
MYSQL_ROOT_PASSWORD=rootpassword

# Grafana admin password (default 'admin' is local-dev only)
GRAFANA_ADMIN_PASSWORD=admin

# Host-side ports (container ports unchanged). Defaults avoid clashes with a native
# Windows MySQL (3306) and the Windows-reserved 3000 range.
MYSQL_HOST_PORT=13306
GRAFANA_HOST_PORT=13000
REDIS_HOST_PORT=6379
API_HOST_PORT=8000
NGINX_HOST_PORT=80
PROMETHEUS_HOST_PORT=9090

# Django ALLOWED_HOSTS for the compose api/celery containers (dev). Must include 'api'
# for Prometheus scrapes. Prod: set real domains via ALLOWED_HOSTS in prod env only.
API_ALLOWED_HOSTS=localhost,127.0.0.1,10.0.2.2,.ngrok-free.app,api
