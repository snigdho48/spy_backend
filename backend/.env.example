# Django
DJANGO_SETTINGS_MODULE=config.settings.dev
SECRET_KEY=change-me-in-production-use-64-chars-minimum
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,10.0.2.2,.ngrok-free.app
# Comma-separated hosts Django will serve. Prod: set your real domains only.
# CORS: comma-separated full origins allowed for browsers (empty = none).
# Dev settings (config.settings.dev) allow all origins regardless.
CORS_ALLOWED_ORIGINS=

# Database (MySQL 8+ — local install, no Docker)
MYSQL_DATABASE=spylove
MYSQL_USER=spylove
MYSQL_PASSWORD=spylove
MYSQL_HOST=localhost
MYSQL_PORT=3306
DB_CONN_MAX_AGE=60

# Local dev: false = no Redis required (in-memory cache/channels)
USE_REDIS=false

# Redis (only when USE_REDIS=true)
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# JWT
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=15
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# Google Sign-In (OAuth client IDs from Firebase / Google Cloud Console)
GOOGLE_CLIENT_IDS=1098260301010-vifp1hi2vohcjfd30no1uj75h1t2hpu1.apps.googleusercontent.com

# Observability
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
SENTRY_DSN=

# Storage (S3-compatible / DigitalOcean Spaces)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=spylove-media
AWS_S3_ENDPOINT_URL=https://nyc3.digitaloceanspaces.com
AWS_S3_REGION_NAME=nyc3
