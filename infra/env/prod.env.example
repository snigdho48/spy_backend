# Prod env example for the TX6. deploy-spy.sh copies this to
# $HOME/.config/spy-backend/prod.env on first install and replaces each
# placeholder value with random hex. Never commit the generated file.
#
# Compose interpolates this file. Keep values unquoted hex (no $ or #).

DJANGO_SETTINGS_MODULE=config.settings.prod
DEBUG=False
SECRET_KEY=__CHANGE_ME__
ALLOWED_HOSTS=spy.way2points.com
CSRF_TRUSTED_ORIGINS=https://spy.way2points.com
CORS_ALLOWED_ORIGINS=
USE_REDIS=true

# Django talks to the compose service name "mariadb" (MariaDB 11, mysql backend).
MYSQL_DATABASE=spylove
MYSQL_USER=spylove
MYSQL_PASSWORD=__CHANGE_ME__
MYSQL_ROOT_PASSWORD=__CHANGE_ME__
MYSQL_HOST=mariadb
MYSQL_PORT=3306
DB_CONN_MAX_AGE=15

REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# Dedicated HMAC key. Prod settings use it when non-empty.
JWT_SIGNING_KEY=__CHANGE_ME__
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=15
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# Public OAuth client IDs (not a secret). Comma-separated. Leave blank to disable.
GOOGLE_CLIENT_IDS=
SENTRY_DSN=

# Fernet key for sensitive payload fields (required in prod)
FIELD_ENCRYPTION_KEY=
